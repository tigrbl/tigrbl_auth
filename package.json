    "build:service-admin-uix": "npm run build -w @tba/ui-service-administration",
    "build:my-account-uix": "npm run build -w @tba/ui-my-account",
    "build:demo-hub-uix": "npm run build -w @tba/ui-demo-hub",
    "build:public-uix": "npm run build -w @tba/ui-public",
    "build:rp": "npm run build -w @tba/client-oidc-relying-party",
    "build:uix": "npm run build:uix-core && npm run build:admin-uix && npm run build:platform-admin-uix && npm run build:tenant-admin-uix && npm run build:developer-uix && npm run build:service-admin-uix && npm run build:my-account-uix && npm run build:demo-hub-uix && npm run build:public-uix",
    "test:uix-core": "npm run test -w @tba/ui-primitives",
    "test:admin-uix": "npm run test -w @tba/ui-administration",
    "test:platform-admin-uix": "npm run test -w @tba/ui-platform-administration",
    "test:tenant-admin-uix": "npm run test -w @tba/ui-tenant-administration",
    "test:developer-uix": "npm run test -w @tba/ui-developer",
    "test:service-admin-uix": "npm run test -w @tba/ui-service-administration",
    "test:my-account-uix": "npm run test -w @tba/ui-my-account",
    "test:demo-hub-uix": "npm run test -w @tba/ui-demo-hub",
    "test:public-uix": "npm run test -w @tba/ui-public",
    "test:rp": "npm run test -w @tba/client-oidc-relying-party",
    "test:uix": "npm run test:uix-core && npm run test:admin-uix && npm run test:platform-admin-uix && npm run test:tenant-admin-uix && npm run test:developer-uix && npm run test:service-admin-uix && npm run test:my-account-uix && npm run test:demo-hub-uix && npm run test:public-uix"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^6.2.0",
    "typescript": "~5.8.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
